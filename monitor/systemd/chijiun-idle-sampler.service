[Unit]
Description=Oracle 閒置回收風險取樣並回報 Uptime Kuma
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/chijiun-monitor.env
ExecStart=/usr/bin/python3 /var/www/chijiun/monitor/bin/idle-sampler.py
# 不用 root 執行；樣本存在 /var/lib/chijiun-monitor
DynamicUser=yes
StateDirectory=chijiun-monitor
# 摘要（summary.json）放這裡，Caddy 才讀得到；oneshot 結束後要保留，否則檔案會被清掉
RuntimeDirectory=chijiun-monitor
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
